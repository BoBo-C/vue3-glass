{
  "name": "@ai1144/glass",
  "version": "0.1.0",
  "description": "Apple-inspired glassmorphism components for Vue 3",
  "type": "module",
  "main": "dist/glass.umd.cjs",
  "module": "dist/glass.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/glass.es.js",
      "require": "./dist/glass.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./src/styles/base.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "keywords": [
    "vue",
    "glass",
    "glassmorphism",
    "backdrop-filter"
  ],
  "author": "@ai1144",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "postcss": "^8.4.30",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vue": "^3.3.0",
    "vue-tsc": "^1.8.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "vitest": "^1.1.0"
  }
}